# Sklovera — static SPA hosting (Vite build) for Apache / cPanel.

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Serve real files/folders as-is; send everything else to index.html.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^ index.html [L]

  # --- Force HTTPS: uncomment the two lines below AFTER SSL/AutoSSL is active ---
  # RewriteCond %{HTTPS} off
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Ensure WebP is served with the right MIME type
<IfModule mod_mime.c>
  AddType image/webp .webp
</IfModule>

# Gzip text assets
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Cache hashed assets aggressively; keep index.html fresh
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|png|jpe?g|webp|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
